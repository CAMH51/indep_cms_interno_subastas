

<div class="m-5 p-5 border border-2 border-gray-200 rounded-2xl">
<div class="flex justify-center">
    <h2 class="text-2xl font-semibold"><%= titulo %></h2>
</div>
<hr class="h-px my-3 bg-neutral-quaternary border-0">

<% if(errores && errores.length >0) {%> 
    <div class="p-4 mb-4 text-sm text-fg-danger-strong rounded-base bg-danger-soft" role="alert">
        <ul><%errores.forEach(function(e){%> <li><%= e.msg %></li> <%})%></ul>
    </div>
<%}%>

<form action="<%= menuLateral && menuLateral.menu_lateral_id ? '/menus_laterales/' + menuLateral.menu_lateral_id + '?lado=derecho': '/menus_laterales?lado=derecho' %>" method="POST">
    <input type="hidden" name="_csrf" id="" value="<%= csrfToken %>" />

    <div class="grid grid-cols-1 gap-2 mb-2">
        <div>
            <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">Titulo</label>
            <input type="text" id="titulo" name="titulo" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Titulo del evento" value="<%= menuLateral ? menuLateral.titulo : '' %>"  />
        </div>
        <div>
            <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">Texto</label>
            <input type="text" id="texto" name="texto" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Actividad del evento" value="<%= menuLateral ? menuLateral.texto : '' %>"  />
        </div>

        <div>
            <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">URL de la Imagen</label>
            <input type="text" id="url_imagen" name="url_imagen" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Actividad del evento" value="<%= menuLateral ? menuLateral.url_imagen : '' %>"  />
        </div>

        <div>
            <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">Link de Información</label>
            <input type="text" id="link_informacion" name="link_informacion" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Actividad del evento" value="<%= menuLateral ? menuLateral.link_informacion : '' %>"  />
        </div>
    
        <div>
            <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">Orden</label>
            <input type="number" id="orden" name="orden" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Nombre del rol" value="<%= menuLateral ? menuLateral.orden : '' %>"  />
        </div>

        <input type="hidden" id="ubicacion" name="ubicacion" value="derecho">
    </div>

        <% if(menuLateral && menuLateral.menu_lateral_id) {%>
        <div class="flex items-center mb-4">
            <input type="checkbox"  class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft" id="activo" name="activo" <%=  menuLateral.activo ? 'checked' : '' %> >
            <label for="activo" class="select-none ms-2 text-sm font-medium text-heading">Menú Lateral Derecho Activo</label>
        </div>
    <%}%>
    <div>
        <button type="submit" class="text-white bg-success box-border border border-transparent hover:bg-success-strong focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none">Guardar</button>
        <a class="text-white bg-danger box-border border border-transparent shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5" href="/menus_laterales?lado=derecho">Cancelar</a>
    </div>
</form>
</div>
