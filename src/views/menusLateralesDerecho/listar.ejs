<div class="m-5 p-5 border border-2 border-gray-200 rounded-2xl">
    <div class="flex justify-between">
        <a href="/dashboard" class="flex items-center px-2 py-1.5 text-body rounded-base hover:bg-neutral-tertiary hover:text-fg-brand group">
            <svg class="w-5 h-5 transition duration-75 group-hover:text-fg-brand" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/></svg>
            <span class="ms-3">Ir a Dashboard</span>
        </a>
        <h2 class="text-2xl font-semibold">Ménu Derecho</h2>
        <% if(puede('menus_derechos.crear')){%>
            <a class="text-white bg-success box-border border border-transparent hover:bg-success-strong focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" href="/menus_derechos/nuevo"><i class="bi bi-check-circle"></i> Nuevo Menú Derecho</a>    
        <%}%>
    </div>
    <hr class="h-px my-3 bg-neutral-quaternary border-0">
    <%- include('../components/mensajeSuccess.ejs') %>
    <div class="overflow-x-auto rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-xs mt-3 bg-white dark:bg-neutral-900">
        <%- include('../components/mensajeSuccess.ejs') %>
        <table id="tablaMenuDerecho" class="w-full text-sm text-left rtl:text-right text-neutral-600 dark:text-neutral-300">
            <thead class="text-xs uppercase bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700">
                <tr>
                    <th class="px-5 py-3.5 font-semibold">Título</th>
                    <th class="px-5 py-3.5 font-semibold">Texto</th>
                    <th class="px-5 py-3.5 font-semibold text-center">Imagen</th>
                    <th class="px-5 py-3.5 font-semibold">Link Información</th>
                    <th class="px-5 py-3.5 font-semibold text-center">Orden</th>
                    <th class="px-5 py-3.5 font-semibold text-center">Estatus</th>
                    <th class="px-5 py-3.5 font-semibold">Fecha de registro</th>
                    <th class="px-5 py-3.5 font-semibold">Última actualización</th>
                    <th class="px-5 py-3.5 font-semibold text-center">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
                 <% menusLaterales.forEach(menu => { %>
                    <tr class="bg-white hover:bg-neutral-50 dark:bg-neutral-900 dark:hover:bg-neutral-800/60 transition-colors">
                        <td class="px-5 py-3.5 font-medium text-neutral-900 dark:text-neutral-100"><%= menu.titulo %></td>
                        <td class="px-5 py-3.5 text-neutral-500 max-w-xs truncate" title="<%= menu.texto %>"><%= menu.texto || '—' %></td>
                        <td class="px-5 py-3.5 text-center">
                            <% if (menu.url_imagen) { %>
                                <a href="<%= menu.url_imagen %>" target="_blank" rel="noopener noreferrer" class="inline-block group" title="Ver imagen">
                                    <img src="<%= menu.url_imagen %>" alt="<%= menu.titulo %>" class="w-14 h-9 object-cover rounded-md border border-neutral-200 shadow-xs group-hover:scale-105 transition-transform" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-xs text-neutral-400\'>Sin imagen</span>';">
                                </a>
                            <% } else { %>
                                <span class="text-xs text-neutral-400">—</span>
                            <% } %>
                        </td>
                        <td class="px-5 py-3.5 text-neutral-500 max-w-xs truncate">
                            <% if (menu.link_informacion) { %>
                                <a href="<%= menu.link_informacion %>" target="_blank" class="text-blue-600 hover:underline inline-flex items-center gap-1">
                                    <i class="bi bi-link-45deg"></i>
                                    <span class="truncate max-w-[150px]"><%= menu.link_informacion %></span>
                                </a>
                            <% } else { %>
                                <span class="text-neutral-400">—</span>
                            <% } %>
                        </td>
                        <td class="px-5 py-3.5 text-center font-semibold text-neutral-700 dark:text-neutral-300"><%= menu.orden %></td>
                        <td class="px-5 py-3.5 text-center whitespace-nowrap">
                            <% if(menu.activo === true){ %>
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    <span>Activo</span>
                                </span>
                            <% }else{ %>
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-300 dark:bg-rose-950/60 dark:text-rose-300">
                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                    <span>Inactivo</span>
                                </span>
                            <%}%>
                        </td>
                        <td class="px-5 py-3.5 text-neutral-500 whitespace-nowrap"><%= formatearFecha(menu.createdAt) %></td>
                        <td class="px-5 py-3.5 text-neutral-500 whitespace-nowrap"><%= formatearFecha(menu.updatedAt) %></td>
                        <td class="px-5 py-3.5 text-center whitespace-nowrap">
                            <% if(typeof puede === 'function' && puede('menus_derechos.actualizar')){%>
                                <a class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg text-white bg-blue-600 hover:bg-blue-700 shadow-xs focus:ring-4 focus:ring-blue-300 transition-all cursor-pointer" href="/menus_derechos/<%= menu.menu_lateral_id %>/editar"><i class="bi bi-pencil-square"></i> Editar</a> 
                            <%}%>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    
</div>
<script type="module" nonce="<%= nonce %>"> 
    import {dataTable} from '/js/dataTable.js';
    dataTable('tablaMenuDerecho');

</script>