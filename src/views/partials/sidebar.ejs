

<!-- drawer init and show -->
<div>
    <button class="text-white  font-medium leading-5  text-sm px-4 py-2.5 cursor-pointer " type="button" data-drawer-target="drawer-navigation" data-drawer-show="drawer-navigation" aria-controls="drawer-navigation">
        <svg class="w-10 h-10 text-white dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14"/>
        </svg>
    </button>
</div>

<!-- drawer component -->
<div id="drawer-navigation" class="fixed top-0 left-0 z-100 w-72 h-screen p-4 overflow-y-auto transition-transform -translate-x-full bg-white dark:bg-neutral-900 border-e border-neutral-200 dark:border-neutral-800 shadow-xl" tabindex="-1" aria-labelledby="drawer-navigation-label">
  <div class="border-b border-neutral-200 dark:border-neutral-800 pb-4 mb-2 flex items-center justify-between">
      <a href="/dashboard" class="flex items-center space-x-2 rtl:space-x-reverse max-w-[190px]">
         <img src="/img/Logo_horizontal_color_Mesa de trabajo 1.svg" class="w-full h-auto" alt="Logo INDEP" />
      </a>
      <button type="button" data-drawer-hide="drawer-navigation" aria-controls="drawer-navigation" class="text-neutral-500 hover:text-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded-lg w-8 h-8 flex items-center justify-center transition">
         <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/></svg>
         <span class="sr-only">Cerrar menú</span>
      </button>
   </div>

   <!-- Información del Rol / Usuario desde el JSON -->
   <% 
      const rolMostrar = (typeof rolNombre !== 'undefined' && rolNombre) 
         ? rolNombre 
         : ((typeof usuarioActual !== 'undefined' && usuarioActual && usuarioActual.rol) 
            ? usuarioActual.rol.nombre 
            : 'Usuario'); 
   %>
   <div class="px-3 py-2 mb-3 bg-[#611323]/5 dark:bg-[#611323]/20 border border-[#611323]/20 rounded-xl flex items-center justify-between">
      <div class="flex items-center gap-2.5 min-w-0">
         <div class="w-7 h-7 rounded-lg bg-[#611323] text-white flex items-center justify-center text-xs shadow-sm shrink-0">
            <i class="bi bi-shield-check"></i>
         </div>
         <div class="flex flex-col min-w-0">
            <span class="text-[10px] text-neutral-400 font-semibold uppercase tracking-wider">Rol</span>
            <span class="text-xs font-bold text-[#611323] dark:text-red-400 truncate" title="<%= rolMostrar %>"><%= rolMostrar %></span>
         </div>
      </div>
      <% if (typeof usuarioActual !== 'undefined' && usuarioActual && usuarioActual.email) { %>
         <span class="text-[11px] text-neutral-500 font-medium truncate max-w-[90px]" title="<%= usuarioActual.email %>"><%= usuarioActual.email.split('@')[0] %></span>
      <% } %>
   </div>

  <div class="py-2 overflow-y-auto space-y-4">
      <% if (typeof menus !== 'undefined' && Array.isArray(menus) && menus.length > 0) { %>
         <!-- SECCIÓN: MENÚS DINÁMICOS DESDE CONTROL DE ACCESOS -->
         <div>
            <p class="px-2 mb-1.5 text-[11px] font-bold tracking-wider uppercase text-neutral-400">Menús Asignados</p>
            <ul class="space-y-1 font-medium">
               <% 
                  const iconosRutas = {
                     '/dashboard': 'bi-speedometer2',
                     '/entities/new': 'bi-plus-square-dotted',
                     '/entities': 'bi-collection',
                     '/documentos': 'bi-folder2-open',
                     '/usuarios': 'bi-people',
                     '/roles': 'bi-shield-check',
                     '/modulos': 'bi-grid',
                     '/permisos': 'bi-key',
                     '/storages': 'bi-hdd-network',
                     '/sliders': 'bi-images',
                     '/eventos_cursos': 'bi-calendar-event',
                     '/convocatorias_muebles': 'bi-box-seam',
                     '/convocatorias_inmuebles': 'bi-houses',
                     '/menus_principales': 'bi-menu-app',
                     '/menus_izquierdos': 'bi-layout-sidebar',
                     '/menus_derechos': 'bi-layout-sidebar-reverse',
                     'dash': 'bi-speedometer2',
                     'CRELIB': 'bi-plus-square-dotted'
                  };
                  const esAdmin = (typeof rolMostrar !== 'undefined' && (rolMostrar === 'SuperAdmin' || rolMostrar.toLowerCase().includes('admin')));
                  const menusOrdenados = [...menus]
                     .filter(m => {
                        if (esAdmin) return true;
                        if (!m.permissions) return true;
                        return m.permissions.read === 1 || m.permissions.read === true || m.permissions.read === '1';
                     })
                     .sort((a,b) => (a.position || 0) - (b.position || 0));
               %>
               <% menusOrdenados.forEach(function(m) { %>
                  <% 
                     const icono = m.icon || iconosRutas[m.name] || iconosRutas[m.screen] || 'bi-app-indicator';
                     const titulo = m.description || m.name;
                     const ruta = m.name && m.name.startsWith('/') ? m.name : ('/' + (m.name || ''));
                  %>
                  <% if (m.submenus && Array.isArray(m.submenus) && m.submenus.length > 0) { %>
                     <li class="space-y-1">
                        <div class="flex items-center justify-between px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 font-semibold">
                           <div class="flex items-center">
                              <i class="bi <%= icono %> text-lg text-neutral-500"></i>
                              <span class="ms-3"><%= titulo %></span>
                           </div>
                        </div>
                        <ul class="ps-6 space-y-1">
                           <% m.submenus.forEach(function(sub) { %>
                              <li>
                                 <a href="<%= sub.name.startsWith('/') ? sub.name : '/' + sub.name %>" class="flex items-center px-3 py-1.5 text-xs text-neutral-600 dark:text-neutral-300 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                                    <i class="bi bi-circle text-[8px] text-neutral-400 group-hover:text-[#611323] me-2"></i>
                                    <span><%= sub.description || sub.name %></span>
                                 </a>
                              </li>
                           <% }); %>
                        </ul>
                     </li>
                  <% } else { %>
                     <li>
                        <a href="<%= ruta %>" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                           <i class="bi <%= icono %> text-lg text-neutral-500 group-hover:text-[#611323] transition-colors"></i>
                           <span class="ms-3 font-semibold"><%= titulo %></span>
                        </a>
                     </li>
                  <% } %>
               <% }); %>
            </ul>
         </div>
      <% } else { %>
         <!-- SECCIÓN: GENERAL (FALLBACK) -->
         <div>
            <p class="px-2 mb-1.5 text-[11px] font-bold tracking-wider uppercase text-neutral-400">Principal</p>
            <ul class="space-y-1 font-medium">
               <li>
                  <a href="/dashboard" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-speedometer2 text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3 font-semibold">Dashboard</span>
                  </a>
               </li>
               <% if (typeof puede === 'function' && puede('documentos.leer')) { %>
               <li>
                  <a href="/documentos" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-folder2-open text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Documentos / Explorer</span>
                  </a>
               </li>
               <% } %>
            </ul>
         </div>

         <!-- SECCIÓN: LIBRERÍAS DINÁMICAS (FALLBACK) -->
         <div>
            <p class="px-2 mb-1.5 text-[11px] font-bold tracking-wider uppercase text-neutral-400">Librerías Dinámicas</p>
            <ul class="space-y-1 font-medium">
               <li>
                  <a href="/entities/new" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-plus-square-dotted text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Nueva Librería</span>
                  </a>
               </li>
            </ul>
         </div>

         <!-- SECCIÓN: CONTENIDO DEL SITIO (FALLBACK) -->
         <% 
            const tieneContenido = typeof puede === 'function' && (
               puede('sliders.leer') || 
               puede('eventos_cursos.leer') || 
               puede('convocatorias_muebles.leer') || 
               puede('convocatorias_inmuebles.leer') || 
               puede('menus_principales.leer') || 
               puede('menus_izquierdos.leer') || 
               puede('menus_derechos.leer')
            );
         %>
         <% if (tieneContenido) { %>
         <div>
            <p class="px-2 mb-1.5 text-[11px] font-bold tracking-wider uppercase text-neutral-400">Contenido del Sitio</p>
            <ul class="space-y-1 font-medium">
               <% if (puede('sliders.leer')) { %>
               <li>
                  <a href="/sliders" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-images text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Sliders</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('eventos_cursos.leer')) { %>
               <li>
                  <a href="/eventos_cursos" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-calendar-event text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Eventos y Cursos</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('convocatorias_muebles.leer')) { %>
               <li>
                  <a href="/convocatorias_muebles" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-box-seam text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Convocatorias Muebles</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('convocatorias_inmuebles.leer')) { %>
               <li>
                  <a href="/convocatorias_inmuebles" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-houses text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Convocatorias Inmuebles</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('menus_principales.leer')) { %>
               <li>
                  <a href="/menus_principales" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-menu-app text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Menús Principales</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('menus_izquierdos.leer')) { %>
               <li>
                  <a href="/menus_izquierdos" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-layout-sidebar text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Menús Izquierdos</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('menus_derechos.leer')) { %>
               <li>
                  <a href="/menus_derechos" class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors">
                     <i class="bi bi-layout-sidebar-reverse text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Menús Derechos</span>
                  </a>
               </li>
               <% } %>
            </ul>
         </div>
         <% } %>

         <!-- SECCIÓN: ADMINISTRACIÓN (FALLBACK) -->
         <% 
            const tieneAdmin = typeof puede === 'function' && (
               puede('usuarios.leer') || 
               puede('roles.leer') || 
               puede('modulos.leer') || 
               puede('permisos.leer') || 
               puede('storages.leer')
            );
         %>
         <% if (tieneAdmin) { %>
         <div>
            <p class="px-2 mb-1.5 text-[11px] font-bold tracking-wider uppercase text-neutral-400">Administración</p>
            <ul class="space-y-1 font-medium">
               <% if (puede('usuarios.leer')) { %>
               <li>
                  <a class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors" href="/usuarios">
                     <i class="bi bi-people text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Usuarios</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('roles.leer')) { %>
               <li>
                  <a class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors" href="/roles">
                     <i class="bi bi-shield-check text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Roles</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('modulos.leer')) { %>
               <li>
                  <a class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors" href="/modulos">
                     <i class="bi bi-grid text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Módulos</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('permisos.leer')) { %>
               <li>
                  <a class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors" href="/permisos">
                     <i class="bi bi-key text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Permisos</span>
                  </a>
               </li>
               <% } %>

               <% if (puede('storages.leer')) { %>
               <li>
                  <a class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-200 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-[#611323] group transition-colors" href="/storages">
                     <i class="bi bi-hdd-network text-lg text-neutral-500 group-hover:text-[#611323]"></i>
                     <span class="ms-3">Storages</span>
                  </a>
               </li>
               <% } %>
            </ul>
         </div>
         <% } %>
      <% } %>

      <!-- SECCIÓN: SESIÓN -->
      <div class="pt-2 border-t border-neutral-200 dark:border-neutral-800">
         <form action="/auth/logout" method="POST" class="m-0">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="w-full flex items-center px-3 py-2 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-950/40 rounded-lg transition-colors font-semibold cursor-pointer">
               <i class="bi bi-box-arrow-left text-lg mr-3"></i>
               <span>Cerrar sesión</span>
            </button>
         </form>
      </div>
   </div>
</div>
