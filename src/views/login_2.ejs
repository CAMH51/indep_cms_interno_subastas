  <!DOCTYPE html>
  <html lang="es">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
      <%- include('./partials/navbargobmx.ejs') %>
      <div class="flex items-start justify-center bg-animate font-sans antialiased pt-4">

    <!-- Tarjeta principal: contenedor con efecto glass / sombra moderna -->
    <div class="w-full max-w-md bg-white/80 backdrop-blur-sm rounded-3xl shadow-2xl border border-white/50 p-5 md:p-5 transition-all duration-300 hover:shadow-indigo-300/30 mt-4">

      <!-- Logo / icono decorativo -->
      <div class="flex justify-center mb-6">
        <div class="bg-[#611323] text-white p-4 rounded-2xl shadow-lg shadow-indigo-200/60">
          <i class="bi bi-lock-fill"></i>
        </div>
      </div>

      <!-- Título y subtítulo -->
      <h2 class="text-3xl font-bold text-center text-gray-800 tracking-tight">Bienvenido</h2>
      <p class="text-center text-gray-500 text-sm mt-1 mb-8">Inicia sesión para continuar</p>

    

      <!-- Formulario -->
      <form id="formLogin" class="space-y-6">
        <!-- Campo email -->
        <div class="space-y-1">
          <label for="email" class="block text-sm font-medium text-gray-700 ml-1">
            <i class="bi bi-envelope"></i> Correo electrónico
          </label>
          <div class="relative">
            <input 
              type="text" 
              id="username" 
              name="username"
              placeholder="tú@ejemplo.com" 
              class="w-full pl-11 pr-4 py-3.5 bg-white/70 border border-gray-200 rounded-2xl text-gray-800 placeholder-gray-400 input-focus outline-none"
              required
              autofocus
            />
            <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-gray-400">
              <i class="bi bi-envelope"></i>
            </div>
          </div>
        </div>

        <!-- Campo contraseña -->
        <div class="space-y-1">
          <label for="password" class="block text-sm font-medium text-gray-700 ml-1">
            <i class="bi bi-key"></i> Contraseña
          </label>
          <div class="relative">
            <input 
              type="password" 
              id="password" 
              name="password" 
              placeholder="••••••••" 
              class="w-full pl-11 pr-12 py-3.5 bg-white/70 border border-gray-200 rounded-2xl text-gray-800 placeholder-gray-400 input-focus outline-none"
              required
            />
            <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-gray-400">
              <i class="bi bi-key"></i>
            </div>
            <!-- Ojo para mostrar/ocultar contraseña -->
            <button 
              type="button" 
              id="togglePassword" 
              class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600 cursor-pointer focus:outline-none"
              aria-label="Mostrar u ocultar contraseña"
            >
              <i class="bi bi-eye" id="togglePasswordIcon"></i>
            </button>
          </div>
        </div>

        <!-- Botón de inicio de sesión -->
        <button 
          type="submit" 
          id="btnSubmit"
          class="w-full bg-[#611323] hover:bg-[#7a182d] text-white font-semibold py-3.5 rounded-2xl shadow-lg transition-all duration-200 transform hover:scale-[1.01] active:scale-[0.98] flex items-center justify-center gap-2 text-lg disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <i class="fas fa-arrow-right-to-bracket" id="btnIcon"></i>
          <span id="btnText">Iniciar sesión</span>
        </button>

      </form>

      <!-- Mensaje de error dinámico (JS / Fetch) -->
      <div id="errorAlert" class="hidden mt-4 p-4 text-sm text-red-800 rounded-2xl bg-red-50 border border-red-200" role="alert">
        <span id="errorMessage"></span>
      </div>

      <% if(error){%> 
        <div class="mt-4 p-4 text-sm text-yellow-800 rounded-2xl bg-yellow-50 border border-yellow-200" role="alert">
          <%= error %>
        </div>
      <%}%>

    </div>
          
    </div>

    <script nonce="<%= nonce %>"> 
      const formLogin = document.getElementById('formLogin');
      const btnSubmit = document.getElementById('btnSubmit');
      const btnText = document.getElementById('btnText');
      const btnIcon = document.getElementById('btnIcon');
      const errorAlert = document.getElementById('errorAlert');
      const errorMessage = document.getElementById('errorMessage');
      const togglePassword = document.getElementById('togglePassword');
      const passwordInput = document.getElementById('password');
      const togglePasswordIcon = document.getElementById('togglePasswordIcon');

      // Mostrar / ocultar contraseña
      if (togglePassword) {
        togglePassword.addEventListener('click', () => {
          const isPassword = passwordInput.getAttribute('type') === 'password';
          passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
          togglePasswordIcon.classList.toggle('bi-eye', !isPassword);
          togglePasswordIcon.classList.toggle('bi-eye-slash', isPassword);
        });
      }

      function mostrarError(mensaje) {
        if (errorMessage && errorAlert) {
          errorMessage.textContent = mensaje;
          errorAlert.classList.remove('hidden');
        }
      }

      function ocultarError() {
        if (errorAlert) {
          errorAlert.classList.add('hidden');
        }
      }

      formLogin.addEventListener('submit', async function(e){
        e.preventDefault();
        ocultarError();
        const formData = new FormData(formLogin);
        const urlToken = '/authCtrlAcceso/login';

        // Estado cargando
        btnSubmit.disabled = true;
        btnText.textContent = 'Iniciando sesión...';
        btnIcon.className = 'fas fa-spinner fa-spin';

        try {
          const response = await fetch(urlToken, {
            method: 'POST',
            body: formData
          });

          const data = await response.json();
          console.log('Respuesta token:', data);

          if (!response.ok) {
            const errorMsg = data.error_description || data.error || 'Error al iniciar sesión. Verifica tus credenciales.';
            mostrarError(errorMsg);
            return;
          }

          // Si Keycloak devuelve access_token exitosamente
          if (data.token) {
            sessionStorage.setItem('kc_token', data.token);
            if (data.mfaToken) {
              sessionStorage.setItem('mfa_token', data.mfaToken);
            }
            const usernameInput = document.getElementById('username');
            const emailVal = data.email || (usernameInput ? usernameInput.value.trim() : '');
            sessionStorage.setItem('auth_email', emailVal);

            document.location.href = '/authCtrlAcceso/mfa';
          } else {
            mostrarError('Respuesta inesperada del servidor de autenticación.');
          }

        } catch (error) {
          console.error('Error en fetch:', error.message);
          mostrarError('Error de conexión o fallo al comunicarse con el servidor de autenticación.');
        } finally {
          btnSubmit.disabled = false;
          btnText.textContent = 'Iniciar sesión';
          btnIcon.className = 'fas fa-arrow-right-to-bracket';
        }
      });
    </script>
  </body>
  </html>