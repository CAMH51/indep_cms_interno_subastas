<div class="flex items-center mb-4">
    <input id="<%= id %>" name="<%= name %>" type="checkbox" value="<%= value %>" class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft" <%= (typeof required !== 'undefined' && required) ? 'required' : '' %> <%= (typeof checked !== 'undefined' && checked) ? 'checked' : '' %>>
    <label for="<%= id %>" class="select-none ms-2 text-sm font-medium text-heading cursor-pointer"><%= label %></label>
</div>