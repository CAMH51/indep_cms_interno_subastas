<a href="<%= url %>" class="inline-flex font-medium items-center text-fg-brand group transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
    <div class="flex justify-center items-center gap-3 bg-neutral-primary-soft w-full p-6 border border-default rounded-base shadow-xs transition-all duration-300 group-hover:border-brand group-hover:bg-neutral-primary">
        <i class='bi <%= icono %> text-4xl font-bold <%= text_color %> group-hover:text-fg-brand'></i>
        <h5 class="mb-2 text-2xl font-semibold tracking-tight text-heading transition-colors group-hover:text-fg-brand"><%= titulo.toUpperCase() %></h5>
    </div>
</a>