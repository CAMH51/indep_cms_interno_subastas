<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./partials/head.ejs')%>
</head>
<body data-token-ttl = "<%= typeof accessTokenTtlMs !== 'undefined' ? accessTokenTtlMs : '' %>">
    <%- include('./partials/navbar.ejs')%>


<div class="">
     <%- include('./' + page ) %>
</div>

<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
  // Detecta si la página se cargó desde la memoria caché del historial (botón Atrás/Adelante)
  window.addEventListener('pageshow', function (event) {
    if (event.persisted || (window.performance && window.performance.getEntriesByType('navigation')[0]?.type === 'back_forward')) {
      // Fuerza al navegador a consultar al servidor nuevamente
      window.location.reload();
    }
  });
</script>