<div class="m-5 p-5 border border-2 border-gray-200 rounded-2xl">
    <div class="flex justify-between">
        <a href="/dashboard" class="flex items-center px-2 py-1.5 text-body rounded-base hover:bg-neutral-tertiary hover:text-fg-brand group">
            <svg class="w-5 h-5 transition duration-75 group-hover:text-fg-brand" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/></svg>
            <span class="ms-3">Ir a Dashboard</span>
        </a>
        <h2 class="text-2xl font-semibold">Roles</h2>
        <% if(puede('roles.crear')){%>
            <a class="text-white bg-success box-border border border-transparent hover:bg-success-strong focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" href="/roles/nuevo"><i class="bi bi-check-circle"></i> Nuevo Rol</a>    
        <%}%>
    </div>
    <hr class="h-px my-3 bg-neutral-quaternary border-0">
    <div>
        <%- include('../components/mensajeSuccess.ejs') %>
        <table id="tablaRoles">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Estatus</th>
                    <th>Fecha de registro</th>
                    <th>Última actualización</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% roles.forEach(rol => { %>
                    <tr>
                        <td><%= rol.nombre %></td>
                        <td><%= rol.descripcion %></td>
                        <td class="px-6 py-4">
                            <% if(rol.activo === true){ %>
                            <span class="bg-success-soft text-fg-success-strong text-xs font-medium px-1.5 py-0.5 rounded">Activo</span>
                            <% }else{ %>
                             <span class="bg-danger-soft text-fg-danger-strong text-xs font-medium px-1.5 py-0.5 rounded">Inactivo</span>
                            <%}%>
                        </td>
                        <td><%= formatearFecha(rol.createdAt) %></td>
                        <td><%= formatearFecha(rol.updatedAt) %></td>
                        <td>
                            <% if(puede('roles.actualizar')){%>
                                <a class="text-white bg-blue-500 box-border border border-transparent hover:bg-blue-700 focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" href="/roles/<%= rol.rol_id %>/editar"><i class="bi bi-pencil-square"></i> Editar</a> 
                            <%}%>
                            <% if(puede('roles.leer')){%>
                                <a class="text-white bg-[#a57f2c] box-border border border-transparent hover:bg-[#e6d194] focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" href="/roles/<%= rol.rol_id %>/permisos"><i class="bi bi-lock"></i> Permisos</a> 
                            <%}%>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    
</div>
<script type="module" nonce="<%= nonce %>"> 
    import {dataTable} from '/js/dataTable.js';
    dataTable('tablaRoles');

    
</script>