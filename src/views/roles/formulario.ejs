

    <div class="m-5 p-5 border border-2 border-gray-200 rounded-2xl">
        <div class="flex justify-center">
            <h2 class="text-2xl font-semibold"><%= titulo %></h2>
        </div>
        <hr class="h-px my-3 bg-neutral-quaternary border-0">
        
        <% if(errores && errores.length >0) {%> 
            <div class="p-4 mb-4 text-sm text-fg-danger-strong rounded-base bg-danger-soft" role="alert">
                <ul><%errores.forEach(function(e){%> <li><%= e.msg %></li> <%})%></ul>
            </div>
        <%}%>
        
        <form action="<%= rol && rol.rol_id ? '/roles/' + rol.rol_id : '/roles' %>" method="POST">
            <input type="hidden" name="_csrf" id="" value="<%= csrfToken %>" />
        
            <div class="grid grid-cols-2 gap-2 mb-2">
                <div>
                    <label for="nombre" class="block mb-2.5 text-sm font-medium text-heading">Nombre</label>
                    <input type="text" id="nombre" name="nombre" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Nombre del rol" value="<%= rol ? rol.nombre : '' %>" required />
                </div>
            
                <div>
                    <label for="descripcion" class="block mb-2.5 text-sm font-medium text-heading">Descripción</label>
                    <input type="text" id="descripcion" name="descripcion" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Descripción del rol" value="<%= rol ? rol.descripcion : '' %>" />
                </div>
            </div>

            
            <% if(rol && rol.rol_id) {%>
                <div class="flex items-center mb-4">
                    <input type="checkbox"  class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft" id="activo" name="activo" <%=  rol.activo ? 'checked' : '' %> >
                    <label for="activo" class="select-none ms-2 text-sm font-medium text-heading">Rol Activo</label>
                </div>
            <%}%>
        
            <div>
                <button type="submit" class="text-white bg-success box-border border border-transparent hover:bg-success-strong focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none">Guardar</button>
                <a class="text-white bg-danger box-border border border-transparent shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5" href="/roles">Cancelar</a>
            </div>
        
        </form>

    </div>
