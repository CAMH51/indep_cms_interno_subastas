

<div class="m-5 p-5 border border-2 border-gray-200 rounded-2xl">
<div class="flex justify-center">
    <h2 class="text-2xl font-semibold"><%= titulo %></h2>
</div>
<hr class="h-px my-3 bg-neutral-quaternary border-0">

<div class="flex items-start sm:items-center p-4 mb-4 text-sm text-fg-warning rounded-base bg-warning-soft" role="alert">
  <svg class="w-4 h-4 me-2 shrink-0 mt-0.5 sm:mt-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
  <p>Campos obligatorios <span class="text-xl font-bold text-red-700">*</span></p>
</div>

<form action="<%= menuPrincipal && menuPrincipal.menu_principal_id ? '/menus_principales/' + menuPrincipal.menu_principal_id : '/menus_principales' %>" method="POST">
    <input type="hidden" name="_csrf" id="" value="<%= csrfToken %>" />

  
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">Titulo:<span class="text-xl font-bold text-red-700">*</span></label>
                <input type="text" id="titulo" name="titulo" class="bg-neutral-secondary-medium border border-[#e6d194] text-heading text-sm rounded-base focus:ring-[#a57f2c] focus:border-[#a57f2c] block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Titulo del menú lateral" value="<%= menuPrincipal ? menuPrincipal.titulo : '' %>"  required/>
            </div>
            <div>
                <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">URL:<span class="text-xl font-bold text-red-700">*</span></label>
                <input type="text" id="url" name="url" class="bg-neutral-secondary-medium border border-[#e6d194] text-heading text-sm rounded-base focus:ring-[#a57f2c] focus:border-[#a57f2c] block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Texto del menú lateral" value="<%= menuPrincipal ? menuPrincipal.url : '' %>"  required/>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">Icono:</label>
                <input type="text" id="icono" name="icono" class="bg-neutral-secondary-medium border border-[#e6d194] text-heading text-sm rounded-base focus:ring-[#a57f2c] focus:border-[#a57f2c] block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="URL de la imagen" value="<%= menuPrincipal ? menuPrincipal.icono : '' %>"  />
            </div>
    
            <div class="mb-4">
                <label for="accion" class="block mb-2.5 text-sm font-medium text-heading">Orden:<span class="text-xl font-bold text-red-700">*</span></label>
                <input type="number" id="orden" name="orden" class="bg-neutral-secondary-medium border border-[#e6d194] text-heading text-sm rounded-base focus:ring-[#a57f2c] focus:border-[#a57f2c] block w-64 px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="0" value="<%= menuPrincipal ? menuPrincipal.orden : maxOrden %>"  required/>
            </div>
        </div>

        <div>
            <label for="sitio_padre" class="block mb-2.5 text-sm font-medium text-heading">Sitio padre:</label>
            <select id="sitio_padre" name="sitio_padre" class="block w-full px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
                <option value="" selected>Seleccione una opción</option>
                <% menusPrincipal.forEach(function(menu){%> 
                    <option value="<%= menu.menu_principal_id %>" <%= menuPrincipal && menuPrincipal.menu_principal_id === menu.sitio_padre ? 'selected' : '' %>><%= menu.titulo %></option>
                <%})%>
            </select>
        </div>

        <% if(menuPrincipal && menuPrincipal.menu_principal_id) {%>
        <div class="flex items-center mb-4">
            <input type="checkbox"  class="w-4 h-4 border border-[#e6d194] rounded-xs bg-neutral-secondary-medium focus:ring-[#a57f2c] focus:border-[#a57f2c]" id="activo" name="activo" <%=  menuPrincipal.activo ? 'checked' : '' %> >
            <label for="activo" class="select-none ms-2 text-sm font-medium text-heading">Menú Principal Activo:<span class="text-xl font-bold text-red-700">*</span></label>
        </div>
    <%}%>
    <div>
        <button type="submit" class="text-white bg-success box-border border border-transparent hover:bg-success-strong focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none"><i class="bi bi-floppy"></i> Guardar</button>
        <a class="text-white bg-danger box-border border border-transparent shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5" href="/menus_principales"><i class="bi bi-x-circle"></i> Cancelar</a>
    </div>
</form>

<% if(errores && errores.length >0) {%> 
    <div id="alert-2" class="flex sm:items-center p-4 mb-4 mt-4 text-sm text-fg-danger-strong rounded-base bg-danger-soft" role="alert">
        <ul>
            <%errores.forEach(function(e){%> 
                <li class="flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0 mt-0.5 md:mt-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                    <span class="sr-only">Info</span>
                    <div class="ms-2 text-sm ">
                        <%= e.msg %>
                    </div>
                </li>
            <%})%>
        </ul>
            <button type="button" class="ms-auto -mx-1.5 -my-1.5 bg-danger-soft text-fg-danger-strong rounded focus:ring-2 focus:ring-danger-medium p-1.5 hover:bg-danger-medium inline-flex items-center justify-center h-8 w-8 shrink-0 shrink-0" data-dismiss-target="#alert-2" aria-label="Close">
                <span class="sr-only">Close</span>
                <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/></svg>
            </button>
        </div>
<%}%>
</div>
