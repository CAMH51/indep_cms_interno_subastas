
<div class="relative bg-neutral-primary-soft max-w-md w-full p-6 border border-default rounded-base shadow-xs mx-auto mt-6">
    <div class="flex flex-col items-center">
        <svg class="w-24 h-24 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0a8.949 8.949 0 0 0 4.951-1.488A3.987 3.987 0 0 0 13 16h-2a3.987 3.987 0 0 0-3.951 3.512A8.948 8.948 0 0 0 12 21Zm3-11a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
        </svg>

        <h5 class="mb-0.5 text-xl font-semibold tracking-tight text-heading"><%= usuario.email %></h5>
        <span class="text-sm text-body"><%= usuario.rol.nombre %></span>
        <div class="mt-4">
            <p class="text-xl font-semibold text-center bg-gray-300 p-2 rounded-2xl">Permisos Asignados</p>
            <div class="mt-4 text-center">
                <% if(permisos.length === 0){%> 
                    <p>Tu rol no tiene permisos asignados todavia</p>
                <%}else{%>
                    <% permisos.forEach(function (permiso){ %> 
                        <span class="bg-brand-softer text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded"><%=permiso%></span>
                        
                    <%});%>
                <%}%>
            </div>
        </div>
    </div>
</div>

