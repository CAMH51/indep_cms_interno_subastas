<div class="m-5 p-5 border border-2 border-gray-200 rounded-2xl">
    <div class="flex justify-between">
        <a href="/dashboard" class="flex items-center px-2 py-1.5 text-body rounded-base hover:bg-neutral-tertiary hover:text-fg-brand group">
            <svg class="w-5 h-5 transition duration-75 group-hover:text-fg-brand" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/></svg>
            <span class="ms-3">Ir a Dashboard</span>
        </a>
        <h2 class="text-2xl font-semibold">Ménu Derecho</h2>
        <% if(puede('menu_derecho.crear')){%>
            <a class="text-white bg-success box-border border border-transparent hover:bg-success-strong focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" href="/menu_derecho/nuevo">Nuevo Menú Derecho</a>    
        <%}%>
    </div>
    <hr class="h-px my-3 bg-neutral-quaternary border-0">

    <%- include('../components/dataTable', {idTable: 'tablaMenuDerecho'}) %>
</div>

<script type="module" nonce="<%= nonce %>"> 
    import {verTabla, refrescarTabla} from '/js/dataTableJS.js';

    const columnasTableNoticias=[
        {title:'Id',data:'id_noticia',width:'50px',className:'text-center'},
        {title:'Archivo',data:'archivo.nombre_archivo',width:'300px',
            render:function(data,type,row,meta){
                return `
                    <span class="inline-flex items-center rounded-md bg-cyan-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-cyan-700/10">
                        ${data}
                    </span>
                `
            }
        },
        {title:'Página Asociada',data:'pagina.nombre_pag',width:'200px'},
        {title:'Etiquetas',data:'etiqueta.etiqueta',width:'150px'},
        {title:'Titulo',data:'titulo',width:'250px'},
        {title:'Descripcion',data:'descripcion',width:'350px'},
        {title:'Estatus',data:'activo',
            render:function(data,type,row,meta){
                if(data){
                    return `
                        <span class="inline-flex items-center rounded-md bg-green-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-green-700/10">
                            Activo
                        </span>
                    `;
                }else{
                    return `
                        <span class="inline-flex items-center rounded-md bg-red-600 px-2 py-1 text-xs font-medium text-white ring-1 ring-inset ring-red-700/10">
                            Inactivo
                        </span>
                    `;
                }
            }
        },
        {title:'Fecha de registro',data:'f_registro', className: "whitespace-nowrap"},
        {title:'Última actualización',data:'f_modificacion', className: "whitespace-nowrap"},
        {title:'Acciones',data:null,
            render:function(data,type,row,meta){
                let html = "";
                html += `<a onclick="openModal(${row.id_noticia},obtenerNoticia)" class="text-indigo-600 hover:text-indigo-900 mr-3"><i class="bi bi-pencil-square"></i></a>`;
                if(row.activo){
                    html +=`
                        <a onclick="activarNoticia(${row.id_noticia},'false')" class="text-red-500 hover:text-red-700"><i class="bi bi-x-circle"></i></a>
                    `;
                }else{
                    html += `
                        <a onclick="activarNoticia(${row.id_noticia},'true')" class="text-green-500 hover:text-green-700"><i class="bi bi-check-circle"></i></a>
                    `;
                }
                return html;
            }
        },

    ];

    verTabla(columnasTableNoticias,'#tablaMenuDerecho','/menu_derecho/listar');
</script>