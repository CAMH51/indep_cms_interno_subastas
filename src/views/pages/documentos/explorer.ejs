<% if ((subfolders && subfolders.length > 0) || (files && files.length > 0)) { %>
  <div class="m-4 md:m-6">
    <!-- Contenedor con altura máxima y scroll suave -->
    <div class="relative overflow-x-auto overflow-y-auto max-h-[640px] border border-neutral-200 dark:border-neutral-800 rounded-xl shadow-xs z-10 bg-white dark:bg-neutral-900">
      <table class="w-full text-sm text-left rtl:text-right text-neutral-600 dark:text-neutral-300">
        <thead class="text-xs uppercase bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700 sticky top-0 z-10 shadow-xs">
          <tr>
            <th scope="col" class="px-5 py-3.5 font-semibold">Nombre</th>
            <th scope="col" class="px-5 py-3.5 font-semibold">Tamaño / Contenido</th>
            <th scope="col" class="px-5 py-3.5 font-semibold">Fecha de Modificación</th>
            <th scope="col" class="px-5 py-3.5 font-semibold text-center">Visibilidad</th>
            <th scope="col" class="px-5 py-3.5 font-semibold">Link</th>
            <th scope="col" class="px-5 py-3.5 font-semibold text-center">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">

          <!-- CARPETAS -->
          <% if (subfolders && subfolders.length > 0) { %>
            <% subfolders.forEach(folder => { %>
              <tr class="bg-white hover:bg-neutral-50 dark:bg-neutral-900 dark:hover:bg-neutral-800/60 transition-colors">
                <td class="px-5 py-3.5">
                  <a href="/folders/<%= folder.folder_id %>" class="folder-info hover:underline inline-flex items-center gap-3">
                    <img src="/img/icons/carpeta.png" alt="Carpeta" class="w-6 h-6 object-contain flex-shrink-0">
                    <span class="font-medium text-neutral-900 dark:text-neutral-100 hover:text-blue-600" title="<%= folder.name %>"><%= folder.name %></span>
                  </a>
                </td>
                <td class="px-5 py-3.5 text-neutral-500 whitespace-nowrap">
                  <span>
                    <i class="bi bi-folder2 text-neutral-400"></i> <%= (folder.subfolders ? folder.subfolders.length : 0) %> carpetas
                    <span class="mx-1 text-neutral-300">|</span>
                    <i class="bi bi-file-earmark text-neutral-400"></i> <%= (folder.files ? folder.files.length : 0) %> archivos
                  </span>
                </td>
                <td class="px-5 py-3.5 text-neutral-500 whitespace-nowrap">
                  <%= formatearFecha(folder.updatedAt) %>
                </td>
                <td class="px-5 py-3.5 text-center text-neutral-400">
                  <span>—</span>
                </td>
                <td class="px-5 py-3.5 text-neutral-400">
                  <span>—</span>
                </td>
                <td class="px-5 py-3.5 text-center whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5">
                    <button type="button" class="p-2 rounded-lg bg-neutral-100 hover:bg-neutral-200 text-neutral-700 btn_renombrar_folder transition" title="Renombrar carpeta" data-folder-id="<%= folder.folder_id %>" data-folder-name="<%= folder.name.replace(/'/g, '\\\'') %>" data-folder-color="<%= folder.color %>">
                      <i class="bi bi-pencil-square"></i>
                    </button>
                    <button type="submit" class="p-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 btn_delete_folder transition" data-folder-id="<%= folder.folder_id %>" title="Eliminar carpeta">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>

          <!-- ARCHIVOS -->
          <% if (files && files.length > 0) { %>
            <% files.forEach(file => { %>
              <%
                const category = file.fileCategory;
                let iconClass = 'bi-file-earmark-text';
                if (category === 'image') { iconClass = '/img/icons/imagenes.png'; }
                else if (category === 'pdf') { iconClass = '/img/icons/archivo-pdf.png'; }
                else if (category === 'video') { iconClass = '/img/icons/carpeta.png'; }
                else if (category === 'audio') { iconClass = '/img/icons/carpeta.png'; }
                else if (category === 'archive') { iconClass = '/img/icons/carpeta-zip.png'; }
                else if (category === 'code') { iconClass = '/img/icons/carpeta.png'; }
                else if (category === 'powerpoint') { iconClass = '/img/icons/powerpoint.png'; }
                else if (category === 'word') { iconClass = '/img/icons/word.png'; }
                else if (category === 'excel') { iconClass = '/img/icons/excel.png'; }

                const rawUrl = `${appUrl}/raw/${file.public_code}`;
              %>
              <tr class="bg-white hover:bg-neutral-50 dark:bg-neutral-900 dark:hover:bg-neutral-800/60 transition-colors" id="file-row-<%= file.file_id %>">
                <td class="px-5 py-3.5">
                  <div class="flex items-center gap-3">
                    <img src="<%= iconClass %>" alt="Archivo" class="w-6 h-6 object-contain flex-shrink-0">
                    <span class="font-medium text-neutral-900 dark:text-neutral-100 truncate max-w-xs" title="<%= file.name %>"><%= file.name %></span>
                  </div>
                </td>
                <!-- Tamaño -->
                <td class="px-5 py-3.5 text-neutral-500 whitespace-nowrap">
                  <span><i class="fa-solid fa-weight-hanging text-neutral-400 text-xs mr-1"></i> <%= file.formattedSize %></span>
                </td>
                <!-- Fecha -->
                <td class="px-5 py-3.5 text-neutral-500 whitespace-nowrap">
                  <%= formatearFecha(file.updatedAt) %>
                </td>
                <!-- COLUMNA VISIBILIDAD (BOTÓN TOGGLE INTERACTIVO) -->
                <td class="px-5 py-3.5 text-center whitespace-nowrap">
                  <button type="button"
                    class="btn-toggle-visibility inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer transition-colors shadow-xs <%= file.is_public ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200 border border-emerald-300' : 'bg-amber-100 text-amber-800 hover:bg-amber-200 border border-amber-300' %>"
                    data-file-id="<%= file.file_id %>"
                    data-is-public="<%= file.is_public ? 'true' : 'false' %>"
                    data-raw-url="<%= rawUrl %>"
                    title="Haz clic para cambiar visibilidad">
                    <% if (file.is_public) { %>
                      <i class="bi bi-globe2"></i> <span>Público</span>
                    <% } else { %>
                      <i class="bi bi-lock-fill"></i> <span>Privado</span>
                    <% } %>
                  </button>
                </td>
                <!-- COLUMNA LINK -->
                <td class="px-5 py-3.5">
                  <div class="fixed-link-box flex items-center gap-2">
                    <% if (file.is_public) { %>
                      <!-- Estado Público: muestra el link directo -->
                      <span class="fixed-link-text text-xs text-neutral-600 truncate max-w-[180px]" title="<%= rawUrl %>">
                        <i class="bi bi-link-45deg text-blue-600"></i> <%= rawUrl %>
                      </span>
                      <button type="button" class="btn-copy bg-white border border-neutral-300 rounded px-2.5 py-1 text-xs hover:bg-neutral-50 shadow-xs transition cursor-pointer" data-link="<%= rawUrl %>">
                        <i class="bi bi-copy"></i> Copiar
                      </button>
                    <% } else { %>
                      <!-- Estado Privado: enlace público deshabilitado -->
                      <span class="text-xs text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 flex items-center gap-1" title="El enlace público está desactivado">
                        <i class="bi bi-shield-lock"></i> Privado (Sin enlace)
                      </span>
                    <% } %>
                  </div>
                </td>
                <td class="px-5 py-3.5 text-center whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5">
                    <button type="button" class="p-2 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 btn_file_versions transition cursor-pointer" title="Historial de versiones" data-file-id="<%= file.file_id %>" data-file-name="<%= file.name.replace(/'/g, '\\\'') %>">
                      <i class="bi bi-clock-history"></i>
                    </button>
                    <button type="button" class="p-2 rounded-lg bg-neutral-100 hover:bg-neutral-200 text-neutral-700 btn_view_file transition cursor-pointer" data-file-id="<%= file.file_id %>" data-code="<%= file.public_code %>" title="Ver archivo">
                      <i class="bi bi-box-arrow-up-right"></i>
                    </button>
                    <a href="/files/<%= file.file_id %>/download" class="p-2 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 transition" title="Descargar archivo">
                      <i class="bi bi-download"></i>
                    </a>
                    <button type="button" class="p-2 rounded-lg bg-neutral-100 hover:bg-neutral-200 text-neutral-700 btn_renombrar_file transition cursor-pointer" title="Renombrar archivo" data-file-id="<%= file.file_id %>" data-file-name="<%= file.name.replace(/'/g, '\\\'') %>">
                      <i class="bi bi-pencil-square"></i>
                    </button>
                    <button type="submit" class="p-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 btnDeleteFile transition cursor-pointer" data-file-id="<%= file.file_id %>" title="Eliminar archivo">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>

        </tbody>
      </table>
    </div>
  </div>
<% } else { %>
  <div class="text-center p-10 border-1 border-gray-300 rounded-xl m-10">
    <div class="text-7xl mb-3 opacity-75"><i class="bi bi-folder2-open"></i></div>
    <div class="text-2xl font-bold">Esta carpeta está vacía</div>
    <div class="text-md m-2">Crea una subcarpeta o sube archivos para comenzar a organizarlos y generar sus URLs fijas.</div>
    <button type="button" class="bg-blue-500 rounded-xl p-3 text-white hover:bg-blue-700" id="btnSubirPrimerArchivo">
      <i class="bi bi-cloud-arrow-up-fill"></i> Subir Primer Archivo
    </button>
  </div>
<% } %>

