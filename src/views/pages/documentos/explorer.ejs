<%- include('../../partials/modals.ejs') %>
<script type="module" nonce="<%= nonce %>">
    import {openModal, copyToClipboard, openRenameFolderModal, openRenameFileModal, showToast} from '/js/explorer.js';

    const btnSubirPrimerArchivo = document.getElementById('btnSubirPrimerArchivo');
    const btnNuevaCarpeta = document.getElementById('btnNuevaCarpeta');
    const btnSubirArchivo = document.getElementById('btnSubirArchivo');

    if (btnSubirPrimerArchivo) {
        btnSubirPrimerArchivo.addEventListener("click", () => openModal('uploadModal'));
    }

    if (btnNuevaCarpeta) {
        btnNuevaCarpeta.addEventListener("click", () => openModal('newFolderModal'));
    }

    if (btnSubirArchivo) {
        btnSubirArchivo.addEventListener("click", () => openModal('uploadModal'));
    }

    function formatBytes(bytes) {
        if (!bytes || bytes === 0 || bytes === '0') return '0 B';
        const num = Number(bytes);
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
        const i = Math.floor(Math.log(num) / Math.log(k));
        return parseFloat((num / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        const d = new Date(dateStr);
        return d.toLocaleDateString('es-MX', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    // Cargar historial de versiones
    async function loadVersions(fileId, fileName) {
        const modalFileName = document.getElementById('versionsModalFileName');
        const versionFileId = document.getElementById('versionFileId');
        const versionsTbody = document.getElementById('versionsTableBody');

        if (modalFileName) modalFileName.textContent = fileName || '';
        if (versionFileId) versionFileId.value = fileId;
        if (versionsTbody) {
            versionsTbody.innerHTML = `
                <tr>
                    <td colspan="7" class="px-4 py-6 text-center text-gray-500">
                        <i class="bi bi-arrow-repeat animate-spin text-indigo-600 mr-2"></i> Cargando historial de versiones...
                    </td>
                </tr>
            `;
        }

        openModal('versionsModal');

        try {
            const response = await fetch(`/files/${fileId}/versions`);
            if (!response.ok) throw new Error('Error al consultar versiones');
            const data = await response.json();
            const versions = data.versions || [];

            if (versions.length === 0) {
                versionsTbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="px-4 py-6 text-center text-gray-400">
                            No hay versiones registradas aún para este archivo.
                        </td>
                    </tr>
                `;
                return;
            }

            versionsTbody.innerHTML = versions.map((ver, idx) => {
                const isLatest = idx === 0;
                const userEmail = ver.usuario?.email || 'Sistema';
                return `
                    <tr class="border-b border-gray-100 hover:bg-gray-50/70 transition">
                        <td class="px-4 py-3 font-semibold text-gray-800">
                            v${ver.version_number}
                            ${isLatest ? '<span class="ml-1.5 px-2 py-0.5 rounded-full text-[10px] bg-green-100 text-green-700 font-bold">Activa</span>' : ''}
                        </td>
                        <td class="px-4 py-3 text-gray-700 max-w-[160px] truncate" title="${ver.original_name}">
                            ${ver.original_name}
                        </td>
                        <td class="px-4 py-3 text-gray-500">${formatBytes(ver.size)}</td>
                        <td class="px-4 py-3 text-gray-600 truncate max-w-[120px]" title="${userEmail}">${userEmail}</td>
                        <td class="px-4 py-3 text-gray-500">${formatDate(ver.createdAt)}</td>
                        <td class="px-4 py-3 text-gray-600 italic max-w-[150px] truncate" title="${ver.comment || 'Sin notas'}">
                            ${ver.comment || '—'}
                        </td>
                        <td class="px-4 py-3 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <a href="/files/${fileId}/versions/${ver.version_id}/download"
                                   class="p-1.5 rounded bg-blue-50 text-blue-600 hover:bg-blue-100 transition"
                                   title="Descargar esta versión">
                                    <i class="bi bi-download"></i>
                                </a>
                                ${!isLatest ? `
                                    <button type="button"
                                            class="btn_restore_version px-2 py-1 rounded bg-amber-50 text-amber-700 hover:bg-amber-100 text-xs font-medium transition"
                                            data-file-id="${fileId}"
                                            data-version-id="${ver.version_id}"
                                            data-version-num="${ver.version_number}"
                                            title="Restaurar a esta versión">
                                        <i class="bi bi-arrow-counterclockwise mr-1"></i> Restaurar
                                    </button>
                                ` : ''}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        } catch (err) {
            console.error(err);
            if (versionsTbody) {
                versionsTbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="px-4 py-6 text-center text-red-500">
                            No se pudieron cargar las versiones del archivo.
                        </td>
                    </tr>
                `;
            }
        }
    }

    // Subir nueva versión mediante AJAX
    const uploadNewVersionForm = document.getElementById('uploadNewVersionForm');
    if (uploadNewVersionForm) {
        uploadNewVersionForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const fileId = document.getElementById('versionFileId').value;
            const fileInput = document.getElementById('newVersionFileInput');
            const submitBtn = document.getElementById('btnSubmitNewVersion');

            if (!fileInput.files || fileInput.files.length === 0) {
                showToast('Selecciona un archivo para la nueva versión');
                return;
            }

            const formData = new FormData(this);
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="bi bi-arrow-repeat animate-spin"></i> Subiendo...';

            try {
                const response = await fetch(`/files/${fileId}/versions`, {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();

                if (response.ok && result.success) {
                    showToast(result.message || 'Nueva versión subida exitosamente');
                    uploadNewVersionForm.reset();
                    // Recargar la lista de versiones
                    const currentFileName = document.getElementById('versionsModalFileName')?.textContent;
                    await loadVersions(fileId, currentFileName);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showToast(result.message || result.error || 'Error al subir la versión');
                }
            } catch (err) {
                console.error(err);
                showToast('Error de red al subir la versión');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-upload"></i> Subir Versión';
            }
        });
    }

    // Delegación de eventos clic
    document.addEventListener('click', async function(e) {
        const btnRenameFile = e.target.closest('.btn_renombrar_file');
        const btnCopiar = e.target.closest('.btn-copy');
        const btnViewFile = e.target.closest('.btn_view_file');
        const btnRenameFolder = e.target.closest('.btn_renombrar_folder');
        const btnDeleteFile = e.target.closest('.btnDeleteFile');
        const btnDeleteFolder = e.target.closest('.btn_delete_folder');
        const btnToggle = e.target.closest('.btn-toggle-visibility');
        const btnFileVersions = e.target.closest('.btn_file_versions');
        const btnRestore = e.target.closest('.btn_restore_version');

        // Historial de versiones modal
        if (btnFileVersions) {
            const fileId = btnFileVersions.dataset.fileId;
            const fileName = btnFileVersions.dataset.fileName;
            loadVersions(fileId, fileName);
            return;
        }

        // Restaurar versión anterior
        if (btnRestore) {
            const fileId = btnRestore.dataset.fileId;
            const versionId = btnRestore.dataset.versionId;
            const versionNum = btnRestore.dataset.versionNum;

            if (confirm(`¿Deseas restaurar el archivo a la versión v${versionNum}? Esta pasará a ser la versión activa.`)) {
                btnRestore.disabled = true;
                try {
                    const response = await fetch(`/files/${fileId}/versions/${versionId}/restore`, {
                        method: 'POST'
                    });
                    const resJson = await response.json();
                    if (response.ok && resJson.success) {
                        showToast(`Restaurado con éxito a v${versionNum}`);
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast(resJson.message || 'Error al restaurar');
                        btnRestore.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Error de conexión al restaurar');
                    btnRestore.disabled = false;
                }
            }
            return;
        }

        // Renombrar Archivos
        if (btnRenameFile) {
            const id = btnRenameFile.dataset.fileId;
            const name = btnRenameFile.dataset.fileName;
            openRenameFileModal(id, name);
            return;
        }

        // Renombrar Carpetas
        if (btnRenameFolder) {
            const id = btnRenameFolder.dataset.folderId;
            const name = btnRenameFolder.dataset.folderName;
            const color = btnRenameFolder.dataset.folderColor;
            openRenameFolderModal(id, name, color);
            return;
        }

        // Eliminar archivos
        if (btnDeleteFile) {
            const id = btnDeleteFile.dataset.fileId;
            if (confirm('¿Deseas eliminar este archivo definitivamente?')) {
                const response = await fetch(`/files/${id}/delete`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });
                if (response.ok) {
                    document.location.reload();
                } else {
                    showToast('Error al eliminar el archivo');
                }
            }
            return;
        }

        // Eliminar carpetas
        if (btnDeleteFolder) {
            const id = btnDeleteFolder.dataset.folderId;
            if (confirm('¿Deseas eliminar esta carpeta definitivamente?')) {
                const response = await fetch(`/folders/${id}/delete`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });
                if (response.ok) {
                    document.location.reload();
                } else {
                    showToast('Error al eliminar la carpeta');
                }
            }
            return;
        }

        // Copiar al portapapeles el link
        if (btnCopiar) {
            const link = btnCopiar.dataset.link || btnCopiar.dataset.fileId;
            if (link) copyToClipboard(link);
            return;
        }

        // Cambiar visibilidad (Público / Privado)
        if (btnToggle) {
            const fileId = btnToggle.dataset.fileId;
            btnToggle.disabled = true;

            try {
                const response = await fetch(`/files/${fileId}/toggle-visibility`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    const nuevoEstadoPublico = data.is_public;
                    btnToggle.dataset.isPublic = nuevoEstadoPublico ? 'true' : 'false';

                    // 1. Actualizar estilos del botón
                    if (nuevoEstadoPublico) {
                        btnToggle.className = 'btn-toggle-visibility inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer transition-colors shadow-xs bg-emerald-100 text-emerald-800 hover:bg-emerald-200 border border-emerald-300';
                        btnToggle.innerHTML = '<i class="bi bi-globe2"></i> <span>Público</span>';
                    } else {
                        btnToggle.className = 'btn-toggle-visibility inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer transition-colors shadow-xs bg-amber-100 text-amber-800 hover:bg-amber-200 border border-amber-300';
                        btnToggle.innerHTML = '<i class="bi bi-lock-fill"></i> <span>Privado</span>';
                    }

                    // 2. Actualizar la celda Link en la tabla inmediatamente
                    const row = document.getElementById(`file-row-${fileId}`);
                    if (row) {
                        const linkBox = row.querySelector('.fixed-link-box');
                        const rawUrl = data.rawUrl || btnToggle.dataset.rawUrl;
                        if (linkBox && rawUrl) {
                            btnToggle.dataset.rawUrl = rawUrl;
                            if (nuevoEstadoPublico) {
                                linkBox.innerHTML = `
                                    <span class="fixed-link-text text-xs text-neutral-600 truncate max-w-[180px]" title="${rawUrl}">
                                        <i class="bi bi-link-45deg text-blue-600"></i> ${rawUrl}
                                    </span>
                                    <button type="button" class="btn-copy bg-white border border-neutral-300 rounded px-2.5 py-1 text-xs hover:bg-neutral-50 shadow-xs transition cursor-pointer" data-link="${rawUrl}">
                                        <i class="bi bi-copy"></i> Copiar
                                    </button>
                                `;
                            } else {
                                linkBox.innerHTML = `
                                    <span class="text-xs text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 flex items-center gap-1" title="El enlace público está desactivado">
                                        <i class="bi bi-shield-lock"></i> Privado (Sin enlace)
                                    </span>
                                `;
                            }
                        }
                    }

                    showToast(nuevoEstadoPublico ? 'El archivo ahora es público' : 'El archivo ahora es privado');
                } else {
                    showToast(data.message || 'Error al actualizar visibilidad');
                }
            } catch (err) {
                console.error(err);
                showToast('Error de conexión');
            } finally {
                btnToggle.disabled = false;
            }
            return;
        }

        // Visualizador de archivos
        if (btnViewFile) {
            openModal('viewFileModal');
            const fileId = btnViewFile.dataset.fileId;
            const code = btnViewFile.dataset.code;
            const contenido = document.getElementById('contenido');
            contenido.innerHTML = '<div class="p-6 text-center text-gray-500"><i class="bi bi-arrow-repeat animate-spin text-indigo-600 mr-2 text-xl"></i> Cargando visualizador...</div>';
            
            try {
                let response = fileId ? await fetch(`/files/${fileId}/preview`) : null;
                let data = null;
                if (response && response.ok) {
                    data = await response.json();
                } else if (code) {
                    response = await fetch('/f/' + code);
                    if (response.ok) data = await response.json();
                }

                if (!data || !data.file) {
                    contenido.innerHTML = '<div class="p-6 text-red-500 text-center font-medium">No se pudo cargar la vista previa del archivo.</div>';
                    return;
                }

                const category = data.file.fileCategory;
                const viewUrl = data.previewUrl || `/files/${data.file.file_id}/stream`;
                const downloadUrl = `/files/${data.file.file_id}/download`;

                if (category === 'pdf') {
                    contenido.innerHTML = `
                        <div class="w-full h-[75vh] p-2">
                            <iframe src="${viewUrl}" class="w-full h-full rounded-lg border border-gray-200" frameborder="0"></iframe>
                        </div>
                    `;
                } else if (category === 'image') {
                    contenido.innerHTML = `
                        <div class="flex justify-center items-center p-4 max-h-[70vh] overflow-auto">
                            <img src="${viewUrl}" alt="${data.file.name}" class="max-w-full max-h-[65vh] object-contain rounded-lg shadow-sm" />
                        </div>
                    `;
                } else if (category === 'video') {
                    contenido.innerHTML = `
                        <div class="flex justify-center p-4">
                            <video src="${viewUrl}" controls class="max-w-full max-h-[65vh] rounded-lg"></video>
                        </div>
                    `;
                } else if (category === 'audio') {
                    contenido.innerHTML = `
                        <div class="flex justify-center items-center p-8">
                            <audio src="${viewUrl}" controls class="w-full"></audio>
                        </div>
                    `;
                } else {
                    contenido.innerHTML = `
                        <div class="p-8 text-center text-gray-600">
                            <p class="mb-4">No hay vista previa disponible para este tipo de archivo.</p>
                            <a href="${downloadUrl}" class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                                <i class="bi bi-download"></i> Descargar archivo
                            </a>
                        </div>
                    `;
                }
            } catch (err) {
                console.error(err);
                contenido.innerHTML = '<div class="p-6 text-red-500 text-center font-medium">Error al cargar el visualizador.</div>';
            }
            return;
        }
    });
</script>