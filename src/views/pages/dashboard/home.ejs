<!-- BANNER DE BIENVENIDA -->
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#611323] via-[#7d1a2f] to-[#a57f2c] text-white p-6 md:p-8 shadow-md mb-8">
    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 text-white/90 text-xs font-semibold backdrop-blur-sm mb-3">
                <i class="bi bi-shield-check"></i>
                <span><%= usuarioActual?.rol?.nombre || 'Panel Administrativo' %></span>
            </div>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">
                Bienvenid@<%= usuarioActual?.email ? ', ' + usuarioActual.email.split('@')[0] : '' %>
            </h1>
            <p class="text-white/80 text-sm md:text-base mt-1 max-w-xl">
                CMS Interno para la administración de contenidos, convocatorias, archivos y subastas en línea del INDEP.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/entities/new" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white text-[#611323] font-semibold text-sm hover:bg-neutral-100 shadow-md transition-all">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Nueva Librería</span>
            </a>
            <% if (typeof puede === 'function' && puede('documentos.leer')) { %>
            <a href="/documentos" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/20 hover:bg-white/30 text-white font-semibold text-sm backdrop-blur-sm border border-white/30 transition-all">
                <i class="bi bi-folder2-open"></i>
                <span>Documentos</span>
            </a>
            <% } %>
        </div>
    </div>
    <!-- Decoración geométrica sutil -->
    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/5 rounded-full pointer-events-none"></div>
    <div class="absolute right-32 -top-12 w-48 h-48 bg-white/5 rounded-full pointer-events-none"></div>
</div>


<!-- SECCIÓN: LIBRERÍAS DINÁMICAS -->
<div id="seccion-librerias" class="mb-10">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
                <i class="bi bi-grid-3x3-gap-fill text-[#611323]"></i>
                Librerías Dinámicas
            </h2>
            <p class="text-xs text-neutral-500">Módulos de datos personalizados configurados en el CMS.</p>
        </div>
        <a href="/entities/new" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-[#611323] hover:bg-[#7d1a2f] rounded-lg transition-colors shadow-xs">
            <i class="bi bi-plus-lg"></i>
            <span>Nueva Librería</span>
        </a>
    </div>

    <% if (!entities || entities.length === 0) { %> 
        <div class="p-8 text-center bg-neutral-50 dark:bg-neutral-800/40 border border-neutral-200 dark:border-neutral-800 rounded-xl">
            <i class="bi bi-box-seam text-4xl text-neutral-300 dark:text-neutral-600 mb-2 inline-block"></i>
            <h4 class="text-base font-semibold text-neutral-700 dark:text-neutral-300">No existen librerías creadas todavía</h4>
            <p class="text-xs text-neutral-400 max-w-sm mx-auto mt-1 mb-4">Crea tu primera librería personalizada para comenzar a capturar registros estructurados.</p>
            <a href="/entities/new" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-xs transition">
                <i class="bi bi-plus-circle"></i> Crear una librería
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <% entities.forEach(e => { %> 
                <a href="/entities/<%= e.name %>" class="text-xs font-semibold text-blue-600 hover:text-blue-800 inline-flex items-center gap-1 w-full">
                <div class="w-full bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl p-5 shadow-xs hover:border-[#611323]/50 hover:shadow-md transition-all group flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 mb-3">
                            <span class="w-10 h-10 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-[#611323] flex items-center justify-center text-lg group-hover:bg-[#611323] group-hover:text-white transition-colors">
                                <i class="bi bi-table"></i>
                            </span>
                            <h4 class="text-base font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-[#611323] transition-colors truncate" title="<%= e.name %>">
                                <%= e.name.toUpperCase() %>
                            </h4>
  <!--                           <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                                <%= entities.length > 0  ? entities.length : 0 %> Registros
                            </span> -->
                        </div>
                    </div>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } %>
</div>

