<%- include('../../components/breadcrumb.ejs',{
    links:[
        {url:"/entities/" + entity.name, name: entity.name }
    ]
}) %>

<div class="bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-sm p-4 md:p-6 mb-5">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-[#9b2247]/10 flex items-center justify-center text-[#9b2247]">
                <i class="bi bi-database text-2xl"></i>
            </div>
            <div>
                <div class="flex items-center gap-2.5">
                    <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
                        <%= entity.name.toUpperCase() %>
                    </h2>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#9b2247]/10 text-[#9b2247] border border-[#9b2247]/20">
                        <i class="bi bi-layers"></i> <%= rows.length %> <%= rows.length === 1 ? 'registro' : 'registros' %>
                    </span>
                </div>
                <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 mt-0.5">
                    Administración y gestión de registros de la librería dinámica
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <a 
                href="/entities/new?entity=<%= entity.name %>"
                class="inline-flex items-center gap-2 text-neutral-700 dark:text-neutral-200 bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 border border-neutral-300 dark:border-neutral-700 shadow-xs font-medium rounded-lg text-sm px-3.5 py-2.5 transition-all cursor-pointer"
                title="Configurar o agregar campos a esta librería"
            >
                <i class="bi bi-gear"></i>
                <span>Modificar Campos</span>
            </a>

            <button 
                data-modal-target="addRecordModal" 
                data-modal-toggle="addRecordModal" 
                id="btn_abrir_agregar"
                class="inline-flex items-center gap-2 text-white bg-[#1e5b4f] hover:bg-[#15433a] focus:ring-4 focus:ring-[#1e5b4f]/30 shadow-xs font-medium rounded-lg text-sm px-4 py-2.5 transition-all cursor-pointer focus:outline-none" 
                type="button"
            >
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Registro</span>
            </button> 
        </div>
    </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-5 p-4 rounded-xl border border-red-200 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-2.5">
            <i class="bi bi-exclamation-triangle-fill text-lg"></i>
            <span class="text-sm font-medium"><%= error %></span>
        </div>
        <button type="button" class="text-red-600 hover:text-red-800 cursor-pointer" onclick="this.parentElement.remove()">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
<% } %>

<!-- Modal: Agregar Registro -->
<%- include('../../components/modal.ejs',{
    id: 'addRecordModal',
    title: 'Agregar Registro - ' + entity.name,
    icon: 'bi-plus-circle',
    body: '../pages/records/form_add_record.ejs',
    modalSize: 'max-w-6xl',
    formId: 'form_add_record',
    isEdit: false,
    prefix: 'add_'
}) %>

<!-- Modal: Editar Registro -->
<%- include('../../components/modal.ejs',{
    id: 'editRecordModal',
    title: 'Editar Registro - ' + entity.name,
    icon: 'bi-pencil-square',
    body: '../pages/records/form_add_record.ejs',
    modalSize: 'max-w-6xl',
    formId: 'form_edit_record',
    isEdit: true,
    prefix: 'edit_'
}) %>

<!-- Listado de Registros -->
<%- include('./list_records.ejs'); %>
