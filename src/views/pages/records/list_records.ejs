<% const hasActivoField = entity.fields.some(f => f.name.toLowerCase() === 'activo'); %>

<div class="bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-sm overflow-hidden p-4 md:p-6">
    <div class="overflow-x-auto">
        <table id="tabla<%= entity.name %>" class="w-full text-sm text-left rtl:text-right text-neutral-600 dark:text-neutral-300">
            <thead class="text-xs uppercase bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700">
                <tr>
                    <th class="px-4 py-3.5 font-semibold text-center">ID</th>
                    <% entity.fields.forEach(f => { %>
                        <th class="px-4 py-3.5 font-semibold whitespace-nowrap <%= f.type === 'boolean' || f.name.toLowerCase() === 'activo' || f.type === 'date' || f.type === 'dateonly' ? 'text-center' : 'text-left' %>">
                            <div class="inline-flex items-center gap-1 <%= f.type === 'boolean' || f.name.toLowerCase() === 'activo' || f.type === 'date' || f.type === 'dateonly' ? 'justify-center' : 'justify-start' %>">
                                <span><%= f.label %></span>
                                <% if (f.unique) { %>
                                    <span class="inline-flex items-center text-[10px] font-bold text-amber-700 bg-amber-100 dark:bg-amber-900/40 dark:text-amber-300 px-1.5 py-0.2 rounded border border-amber-300 dark:border-amber-700" title="Campo único: no admite duplicados">
                                        Único
                                    </span>
                                <% } %>
                                <% if (f.required) { %>
                                    <span class="text-red-600 font-bold ml-0.5" title="Campo requerido">*</span>
                                <% } %>
                            </div>
                        </th>
                    <% }) %>
                    <th data-type="html" class="px-4 py-3.5 font-semibold text-center whitespace-nowrap">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
                <% if (rows.length === 0) { %>
                    <tr>
                        <td colspan="<%= entity.fields.length + 2 %>" class="px-4 py-12 text-center text-neutral-400">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <div class="w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-400">
                                    <i class="bi bi-inbox text-2xl"></i>
                                </div>
                                <span class="text-base font-medium text-neutral-600 dark:text-neutral-300">No hay registros cargados</span>
                                <p class="text-xs text-neutral-400">Comienza haciendo clic en "Agregar Registro".</p>
                            </div>
                        </td>
                    </tr>
                <% } else { %>
                    <% rows.forEach((r, i) => { 
                        const recordData = r.toJSON ? r.toJSON() : r;
                    %>
                        <tr class="hover:bg-neutral-50/70 dark:hover:bg-neutral-800/40 transition-colors">
                            <td class="px-4 py-3.5 font-medium text-center text-neutral-900 dark:text-neutral-100 whitespace-nowrap">
                                <%= r.id || r.get('id') %>
                            </td>
                            <% entity.fields.forEach(f => { %>
                                <td class="px-4 py-3.5 whitespace-nowrap <%= f.type === 'boolean' || f.name.toLowerCase() === 'activo' || f.type === 'date' || f.type === 'dateonly' ? 'text-center' : 'text-left' %>">
                                    <% if (f.name.toLowerCase() === 'activo') { %>
                                        <% const isActivo = (r.get(f.name) === true || r.get(f.name) === 1 || r.get(f.name) === 'true' || r.get(f.name) === '1'); %>
                                        <span class="status-badge inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= isActivo ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300' : 'bg-rose-100 text-rose-800 border border-rose-300 dark:bg-rose-950/60 dark:text-rose-300' %>">
                                            <span class="w-1.5 h-1.5 rounded-full <%= isActivo ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                                            <span class="status-text"><%= isActivo ? 'Activo' : 'Inactivo' %></span>
                                        </span>
                                    <% } else if (f.type === 'boolean') { %>
                                        <% const boolVal = (r.get(f.name) === true || r.get(f.name) === 1 || r.get(f.name) === 'true' || r.get(f.name) === '1'); %>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= boolVal ? 'bg-blue-100 text-blue-800 border border-blue-200' : 'bg-neutral-100 text-neutral-600 border border-neutral-200' %>">
                                            <%= boolVal ? 'Sí' : 'No' %>
                                        </span>
                                    <% } else if (f.type === 'date' || f.type === 'dateonly') { %>
                                        <% 
                                            const val = r.get(f.name);
                                            let fechaFormateada = '—';
                                            if (val) {
                                                const d = new Date(val);
                                                if (!isNaN(d.getTime())) {
                                                    fechaFormateada = f.type === 'dateonly' 
                                                        ? d.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
                                                        : d.toLocaleString('es-MX', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                                                } else {
                                                    fechaFormateada = String(val);
                                                }
                                            }
                                        %>
                                        <span class="text-neutral-600 dark:text-neutral-400"><%= fechaFormateada %></span>
                                    <% } else { %>
                                        <% const rawVal = r.get(f.name); %>
                                        <% if (rawVal && typeof rawVal === 'string' && (rawVal.startsWith('http://') || rawVal.startsWith('https://'))) { %>
                                            <a href="<%= rawVal %>" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline inline-flex items-center gap-1 max-w-[200px] truncate" title="<%= rawVal %>">
                                                <i class="bi bi-link-45deg"></i>
                                                <span class="truncate"><%= rawVal %></span>
                                            </a>
                                        <% } else { %>
                                            <span class="max-w-xs truncate inline-block align-middle" title="<%= rawVal %>">
                                                <%= rawVal === null || rawVal === undefined || rawVal === '' ? '—' : rawVal %>
                                            </span>
                                        <% } %>
                                    <% } %>
                                </td>
                            <% }) %>
                            <td class="px-4 py-3.5 whitespace-nowrap text-center">
                                <div class="inline-flex items-center gap-2">
                                    <!-- Boton de Editar -->
                                    <button 
                                        type="button" 
                                        title="Editar registro"
                                        class="btn-editar-record inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg text-white bg-blue-600 hover:bg-blue-700 shadow-xs focus:ring-4 focus:ring-blue-300 transition-all cursor-pointer"
                                        data-modal-target="editRecordModal"
                                        data-modal-toggle="editRecordModal"
                                        data-entity="<%= entity.name %>"
                                        data-record="<%- JSON.stringify(recordData).replace(/"/g, '&quot;') %>"
                                    >
                                        <i class="bi bi-pencil-square"></i>
                                        <span>Editar</span>
                                    </button>

                                    <% if (hasActivoField) { %>
                                        <% const isActivo = (r.get('activo') === true || r.get('activo') === 1 || r.get('activo') === 'true' || r.get('activo') === '1'); %>
                                        <!-- Boton Activar / Desactivar segun sea el caso -->
                                        <button 
                                            type="button"
                                            class="btn-toggle-activo inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg transition-all shadow-xs cursor-pointer <%= isActivo ? 'text-amber-800 bg-amber-100 hover:bg-amber-200 border border-amber-300 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800' : 'text-emerald-800 bg-emerald-100 hover:bg-emerald-200 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800' %>"
                                            data-id="<%= r.get('id') %>"
                                            data-entity="<%= entity.name %>"
                                            data-activo="<%= isActivo ? 'true' : 'false' %>"
                                            title="<%= isActivo ? 'Desactivar registro' : 'Activar registro' %>"
                                        >
                                            <i class="bi <%= isActivo ? 'bi-slash-circle' : 'bi-check-circle' %>"></i>
                                            <span class="btn-toggle-label"><%= isActivo ? 'Desactivar' : 'Activar' %></span>
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Configuración de campos para el script cliente -->
<script id="entity_fields_config" type="application/json">
    <%- JSON.stringify(entity.fields) %>
</script>

<script type="module" nonce="<%= nonce %>"> 
    import { dataTable } from '/js/dataTable.js';

    // Inicializar dataTable
    const tableId = 'tabla<%= entity.name %>';
    dataTable(tableId);

    // Cargar definición de campos de la entidad
    let fieldsData = [];
    try {
        const rawFields = document.getElementById('entity_fields_config')?.textContent;
        if (rawFields) {
            fieldsData = JSON.parse(rawFields);
        }
    } catch (e) {
        console.error('Error al parsear campos de la entidad:', e);
    }

    // ── Funciones de ayuda para mostrar / ocultar modales ──
    function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    // Manejo de botones de cierre con data-modal-hide
    document.addEventListener('click', (e) => {
        const hideBtn = e.target.closest('[data-modal-hide]');
        if (hideBtn) {
            const modalId = hideBtn.getAttribute('data-modal-hide');
            if (modalId) closeModal(modalId);
        }
    });

    // Abrir modal de agregar
    const btnAbrirAgregar = document.getElementById('btn_abrir_agregar');
    if (btnAbrirAgregar) {
        btnAbrirAgregar.addEventListener('click', () => {
            const formAdd = document.getElementById('form_add_record');
            if (formAdd) {
                formAdd.reset();
                formAdd.querySelectorAll('.msg').forEach(m => { m.innerHTML = ''; m.className = 'msg text-xs mt-1'; });
                formAdd.querySelectorAll('input, textarea, select').forEach(input => {
                    input.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
                    input.dataset.duplicate = 'false';
                });
                // Asegurar que el campo 'activo' esté seleccionado por default
                const addActivo = document.getElementById('add_activo');
                if (addActivo) addActivo.checked = true;
            }
            openModal('addRecordModal');
        });
    }

    // ── Funcionalidad de Edición de Registros ──
    document.addEventListener('click', (e) => {
        const btnEdit = e.target.closest('.btn-editar-record');
        if (!btnEdit) return;

        const rawData = btnEdit.dataset.record;
        if (!rawData) return;

        try {
            const record = JSON.parse(rawData);
            const formEdit = document.getElementById('form_edit_record');
            if (!formEdit) return;

            // Configurar acción del formulario para editar
            const entityName = btnEdit.dataset.entity || '<%= entity.name %>';
            const recordId = record.id;
            formEdit.action = `/entities/${entityName}/records/${recordId}`;

            const idInput = document.getElementById('edit_record_id');
            if (idInput) idInput.value = recordId;

            // Poblar campos del formulario de edición
            fieldsData.forEach(f => {
                const inputId = 'edit_' + f.name;
                const input = document.getElementById(inputId);
                if (!input) return;

                const val = record[f.name];

                if (f.type === 'boolean') {
                    input.checked = (val === true || val === 1 || val === '1' || val === 'true');
                } else if (f.type === 'date') {
                    // Formato para input datetime-local: YYYY-MM-DDTHH:mm
                    if (val) {
                        const d = new Date(val);
                        if (!isNaN(d.getTime())) {
                            input.value = d.toISOString().slice(0, 16);
                        } else {
                            input.value = String(val).slice(0, 16);
                        }
                    } else {
                        input.value = '';
                    }
                } else if (f.type === 'dateonly') {
                    // Formato para input date: YYYY-MM-DD
                    if (val) {
                        input.value = String(val).split('T')[0];
                    } else {
                        input.value = '';
                    }
                } else {
                    input.value = (val !== null && val !== undefined) ? val : '';
                }

                // Limpiar errores visuales
                input.dataset.duplicate = 'false';
                input.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
                const fieldWrapper = input.closest('.field') || input.parentElement;
                const msgEl = fieldWrapper?.querySelector('.msg');
                if (msgEl) {
                    msgEl.innerHTML = '';
                    msgEl.className = 'msg text-xs mt-1';
                }
            });

            openModal('editRecordModal');
        } catch (err) {
            console.error('Error al abrir modal de edición:', err);
        }
    });

    // ── Funcionalidad del Botón Activar / Desactivar ──
    document.addEventListener('click', async (e) => {
        const btnToggle = e.target.closest('.btn-toggle-activo');
        if (!btnToggle) return;

        e.preventDefault();
        const id = btnToggle.dataset.id;
        const entityName = btnToggle.dataset.entity || '<%= entity.name %>';
        const currentActivo = btnToggle.dataset.activo === 'true';
        const nextActivo = !currentActivo;

        btnToggle.disabled = true;
        btnToggle.classList.add('opacity-50', 'cursor-not-allowed');

        try {
            const response = await fetch(`/entities/${entityName}/records/${id}/toggle-activo`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ activo: nextActivo })
            });

            if (response.ok) {
                const data = await response.json();
                const nuevoEstado = data.activo !== undefined ? Boolean(data.activo) : nextActivo;

                btnToggle.dataset.activo = nuevoEstado ? 'true' : 'false';

                // Cambiar apariencia del botón según sea el caso
                if (nuevoEstado) {
                    btnToggle.className = 'btn-toggle-activo inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg transition-all shadow-xs cursor-pointer text-amber-800 bg-amber-100 hover:bg-amber-200 border border-amber-300 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800';
                    btnToggle.innerHTML = '<i class="bi bi-slash-circle"></i> <span class="btn-toggle-label">Desactivar</span>';
                    btnToggle.title = 'Desactivar registro';
                } else {
                    btnToggle.className = 'btn-toggle-activo inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg transition-all shadow-xs cursor-pointer text-emerald-800 bg-emerald-100 hover:bg-emerald-200 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800';
                    btnToggle.innerHTML = '<i class="bi bi-check-circle"></i> <span class="btn-toggle-label">Activar</span>';
                    btnToggle.title = 'Activar registro';
                }

                // Actualizar badge en la fila
                const row = btnToggle.closest('tr');
                if (row) {
                    const badge = row.querySelector('.status-badge');
                    if (badge) {
                        badge.className = `status-badge inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold ${nuevoEstado ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300' : 'bg-rose-100 text-rose-800 border border-rose-300 dark:bg-rose-950/60 dark:text-rose-300'}`;
                        badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${nuevoEstado ? 'bg-emerald-500' : 'bg-rose-500'}"></span><span class="status-text">${nuevoEstado ? 'Activo' : 'Inactivo'}</span>`;
                    }

                    // Actualizar el objeto data-record del botón editar en la misma fila
                    const editBtn = row.querySelector('.btn-editar-record');
                    if (editBtn && editBtn.dataset.record) {
                        try {
                            const rec = JSON.parse(editBtn.dataset.record);
                            rec.activo = nuevoEstado;
                            editBtn.dataset.record = JSON.stringify(rec);
                        } catch (err) {}
                    }
                }
            } else {
                const errData = await response.json().catch(() => ({}));
                alert('No se pudo actualizar el estatus: ' + (errData.error || errData.msg || 'Error del servidor'));
            }
        } catch (err) {
            console.error('Error de red al actualizar estatus:', err);
            alert('Error al intentar cambiar el estatus del registro.');
        } finally {
            btnToggle.disabled = false;
            btnToggle.classList.remove('opacity-50', 'cursor-not-allowed');
        }
    });

    // ── Validaciones Dinámicas dependientes de required y tipo ──
    function validateInputField(input, fieldDef) {
        const fieldWrapper = input.closest('.field') || input.parentElement;
        const msgEl = fieldWrapper?.querySelector('.msg');
        const isCheckbox = input.type === 'checkbox';
        const value = isCheckbox ? input.checked : input.value.trim();
        let error = null;

        // 1. Validación de required
        if (fieldDef.required) {
            if (isCheckbox ? !value : value === '') {
                error = `El campo "${fieldDef.label}" es obligatorio.`;
            }
        }

        // 2. Validaciones de formato si tiene valor
        if (!error && value !== '' && !isCheckbox) {
            if (fieldDef.type === 'integer' || fieldDef.type === 'bigint') {
                if (!/^-?\d+$/.test(value)) {
                    error = `"${fieldDef.label}" debe ser un número entero.`;
                }
            } else if (fieldDef.type === 'decimal') {
                if (isNaN(Number(value))) {
                    error = `"${fieldDef.label}" debe ser un número válido.`;
                }
            } else if (fieldDef.type === 'string' && fieldDef.length) {
                if (value.length > fieldDef.length) {
                    error = `"${fieldDef.label}" no debe exceder ${fieldDef.length} caracteres.`;
                }
            }
        }

        // Aplicar estilos de validación
        if (error) {
            input.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
            input.classList.remove('border-neutral-300', 'dark:border-neutral-700');
            if (msgEl) {
                msgEl.innerHTML = `<i class="bi bi-exclamation-circle-fill"></i> ${error}`;
                msgEl.className = 'msg text-red-600 dark:text-red-400 text-xs font-medium mt-1 flex items-center gap-1';
            }
            return false;
        } else {
            // Si no hay error de formato/required y tampoco error de duplicado, limpiar
            if (input.dataset.duplicate !== 'true') {
                input.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
                input.classList.add('border-neutral-300', 'dark:border-neutral-700');
                if (msgEl) {
                    msgEl.innerHTML = '';
                    msgEl.className = 'msg text-xs mt-1';
                }
            }
            return true;
        }
    }

    // ── Validación Asíncrona de Campos Únicos (evitar duplicados) ──
    async function checkUniqueField(input, fieldDef, prefix) {
        if (!fieldDef.unique) return true;
        if (input.type === 'checkbox') return true;

        const value = input.value.trim();
        const fieldWrapper = input.closest('.field') || input.parentElement;
        const msgEl = fieldWrapper?.querySelector('.msg');

        if (value === '') {
            input.dataset.duplicate = 'false';
            return true;
        }

        let excludeId = '';
        if (prefix === 'edit_') {
            const idInput = document.getElementById('edit_record_id');
            if (idInput && idInput.value) {
                excludeId = idInput.value;
            }
        }

        try {
            const entityName = '<%= entity.name %>';
            const url = `/entities/${entityName}/check-unique?field=${encodeURIComponent(fieldDef.name)}&value=${encodeURIComponent(value)}&excludeId=${encodeURIComponent(excludeId)}`;
            const response = await fetch(url);
            if (response.ok) {
                const resData = await response.json();
                if (resData.exists) {
                    input.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-200');
                    input.classList.remove('border-neutral-300', 'dark:border-neutral-700');
                    if (msgEl) {
                        msgEl.innerHTML = `<i class="bi bi-exclamation-circle-fill"></i> Ya existe un registro con este valor para "${fieldDef.label}". No se permiten registros duplicados.`;
                        msgEl.className = 'msg text-red-600 dark:text-red-400 text-xs font-medium mt-1 flex items-center gap-1';
                    }
                    input.dataset.duplicate = 'true';
                    return false;
                } else {
                    input.dataset.duplicate = 'false';
                    // Si el campo es válido de formato/required, limpiar mensaje
                    const formatValid = validateInputField(input, fieldDef);
                    if (formatValid && msgEl) {
                        msgEl.innerHTML = '';
                        msgEl.className = 'msg text-xs mt-1';
                    }
                    return true;
                }
            }
        } catch (err) {
            console.error('Error al verificar unicidad:', err);
        }
        return true;
    }

    // Configurar validación dinámica para un formulario
    function setupFormValidation(formId, prefix) {
        const form = document.getElementById(formId);
        if (!form) return;

        const timers = {};

        // Validaciones en tiempo real (input y blur)
        fieldsData.forEach(f => {
            const inputId = prefix + f.name;
            const input = document.getElementById(inputId);
            if (!input) return;

            const isCheckOrDate = (input.type === 'checkbox' || input.type === 'date' || input.type === 'datetime-local');
            const eventType = isCheckOrDate ? 'change' : 'input';

            input.addEventListener(eventType, () => {
                const ok = validateInputField(input, f);
                if (f.unique && ok) {
                    clearTimeout(timers[inputId]);
                    timers[inputId] = setTimeout(() => {
                        checkUniqueField(input, f, prefix);
                    }, 400);
                }
            });

            input.addEventListener('blur', () => {
                const ok = validateInputField(input, f);
                if (f.unique && ok) {
                    checkUniqueField(input, f, prefix);
                }
            });
        });

        // Validación al enviar el formulario
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            let isValid = true;
            let firstInvalid = null;

            // 1. Validar campos requeridos y de formato
            fieldsData.forEach(f => {
                const inputId = prefix + f.name;
                const input = document.getElementById(inputId);
                if (!input) return;

                const fieldOk = validateInputField(input, f);
                if (!fieldOk) {
                    isValid = false;
                    if (!firstInvalid) firstInvalid = input;
                }
            });

            if (!isValid) {
                if (firstInvalid) {
                    firstInvalid.focus();
                    firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return;
            }

            // 2. Validar campos únicos antes del envío
            const uniqueFields = fieldsData.filter(f => f.unique);
            for (const f of uniqueFields) {
                const inputId = prefix + f.name;
                const input = document.getElementById(inputId);
                if (!input) continue;

                const isUnique = await checkUniqueField(input, f, prefix);
                if (!isUnique) {
                    isValid = false;
                    if (!firstInvalid) firstInvalid = input;
                }
            }

            if (!isValid) {
                if (firstInvalid) {
                    firstInvalid.focus();
                    firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return;
            }

            // Si todas las validaciones pasaron, enviar el formulario
            form.submit();
        });
    }

    // Inicializar validaciones para formulario de agregar y formulario de editar
    setupFormValidation('form_add_record', 'add_');
    setupFormValidation('form_edit_record', 'edit_');
</script>