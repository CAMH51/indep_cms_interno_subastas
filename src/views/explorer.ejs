<% if ((subfolders && subfolders.length > 0) || (files && files.length > 0)) { %>
  <div class="m-6">
    <!-- Contenedor con altura máxima y scroll para que el sticky funcione -->
    <div class="relative overflow-y-auto max-h-[600px] border border-default-medium rounded-md z-10" >
      <table class="w-full text-sm text-left rtl:text-right text-body p-4">
        <thead class="text-sm  bg-neutral-secondary-medium border-b border-default-medium sticky top-0 z-10">
          <tr>
            <th scope="col" class="px-6 py-3 font-medium">Nombre</th>
            <th scope="col" class="px-6 py-3 font-medium">Tamaño / Contenido</th>
            <th scope="col" class="px-6 py-3 font-medium">Fecha de Modificación</th>
            <th scope="col" class="px-6 py-3 font-medium">Link</th>
            <th scope="col" class="px-6 py-3 font-medium">Acciones</th>
          </tr>
        </thead>
        <tbody>

          <!-- CARPETAS -->
          <% if (subfolders && subfolders.length > 0) { %>
            <% subfolders.forEach(folder => { %>
              <tr class="bg-neutral-primary-soft  hover:bg-neutral-secondary-medium p-4">
                <td class="px-3 py-2">
                  <a href="/folders/<%= folder.folder_id %>" class="folder-info hover:underline">
                    <div class="flex items-center gap-4 folder-icon color-<%= folder.color || 'indigo' %>">
                      <img src="/img/icons/carpeta.png" alt="" width="5%">
                      <div class="folder-name" title="<%= folder.name %>"><%= folder.name %></div>
                    </div>
                  </a>
                </td>
                <td>
                  <span>
                    <i class="bi bi-folder2"></i> <%= (folder.subfolders ? folder.subfolders.length : 0) %> carpetas
                    &nbsp;|&nbsp;
                    <i class="bi bi-file-earmark"></i> <%= (folder.files ? folder.files.length : 0) %> archivos
                  </span>
                </td>
                <td>
                  <%= formatearFecha(folder.updatedAt) %>
                </td>
                <td>
                  <span class="text-gray-400">—</span>
                </td>
                <td class="">
                  <button type="button" class="bg-gray-300 rounded-md p-2 btn_renombrar_folder" title="Renombrar carpeta" id="btnRenombrarFolder" data-folder-id="<%= folder.folder_id %>" data-folder-name="<%= folder.name.replace(/'/g, '\\\'') %>" data-folder-color="<%= folder.color %>" >
                    <i class="bi bi-pencil-square"></i>
                  </button>
                  <button type="submit" class="bg-red-300 rounded-md p-2 btn_delete_folder" data-folder-id="<%= folder.folder_id %>" title="Eliminar carpeta">
                    <i class="bi bi-trash3"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } %>

          <!-- ARCHIVOS -->
          <% if (files && files.length > 0) { %>
            <% files.forEach(file => { %>
              <%
                const category = file.fileCategory;
                let iconClass = 'bi-file-earmark-text';
                if (category === 'image') { iconClass = '/img/icons/imagenes.png'; }
                else if (category === 'pdf') { iconClass = '/img/icons/archivo-pdf.png'; }
                else if (category === 'video') { iconClass = '/img/icons/carpeta.png'; }
                else if (category === 'audio') { iconClass = '/img/icons/carpeta.png'; }
                else if (category === 'archive') { iconClass = '/img/icons/carpeta-zip.png'; }
                else if (category === 'code') { iconClass = '/img/icons/carpeta.png'; }
                else if (category === 'powerpoint') { iconClass = '/img/icons/powerpoint.png'; }
                else if (category === 'word') { iconClass = '/img/icons/word.png'; }
                else if (category === 'excel') { iconClass = '/img/icons/excel.png'; }

                const rawUrl = `${appUrl}/raw/${file.public_code}`;
              %>
              <tr class="bg-neutral-primary-soft hover:bg-neutral-secondary-medium p-2">
                <td class="flex items-center gap-4 px-4 py-2">
                  <img src="<%= iconClass %>" alt="" width="5%">
                  <div class="file-name" title="<%= file.name %>"><%= file.name %></div>
                </td>
                <td>
                  <span><i class="fa-solid fa-weight-hanging"></i> <%= file.formattedSize %></span>
                </td>
                <td>
                  <%= formatearFecha(file.updatedAt) %>
                </td>
                <td>
                  <div class="fixed-link-box">
                    <span class="fixed-link-text" title="<%= rawUrl %>">
                      <i class="bi bi-link mr-4"></i> <%= rawUrl %>
                    </span>
                    <button type="button" class="btn-copy border-1 border-gray-200 p-1" data-file-id="<%= rawUrl %>" id="btnCopiar">
                      <i class="bi bi-copy"></i> Copiar
                    </button>
                  </div>
                </td>
                <td class="">
                  <button type="button" id="btnViewFileModal" class="bg-gray-400 rounded-md p-2 btn_view_file" data-code="<%= file.public_code %>">
                    <i class="bi bi-box-arrow-up-right"></i> Ver
                  </button>
                  <a href="/raw/<%= file.public_code %>?download=1" class="bg-blue-100 rounded-md p-2" title="Descargar archivo">
                    <i class="bi bi-download"></i>
                  </a>
                  <button type="button" class="bg-gray-300 rounded-md p-2 btn_renombrar_file" title="Renombrar archivo" id="btnRenombrarFile" data-file-id="<%= file.file_id %>" data-file-name="<%= file.name.replace(/'/g, '\\\'') %>">
                    <i class="bi bi-pencil-square"></i>
                  </button>
                  <button type="submit" class="bg-red-300 rounded-md p-2 btnDeleteFile" data-file-id="<%= file.file_id %>" title="Eliminar archivo">
                    <i class="bi bi-trash3"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } %>

        </tbody>
      </table>
    </div>
  </div>
<% } else { %>
  <div class="text-center p-10 border-1 border-gray-300 rounded-xl m-10">
    <div class="text-7xl mb-3 opacity-75"><i class="bi bi-folder2-open"></i></div>
    <div class="text-2xl font-bold">Esta carpeta está vacía</div>
    <div class="text-md m-2">Crea una subcarpeta o sube archivos para comenzar a organizarlos y generar sus URLs fijas.</div>
    <button type="button" class="bg-blue-500 rounded-xl p-3 text-white hover:bg-blue-700" id="btnSubirPrimerArchivo">
      <i class="bi bi-cloud-arrow-up-fill"></i> Subir Primer Archivo
    </button>
  </div>
<% } %>

